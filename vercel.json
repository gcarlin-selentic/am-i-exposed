{
  "buildCommand": "echo 'Static site with serverless API functions'",
  "outputDirectory": ".",
  "env": {
    "HIBP_API_KEY": "@hibp_api_key"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
